# ==============================================================================
# PHOENIX-EVAL Configuration Environment Variables
# Copy this file to .env for local configuration: cp .env.example .env
# NOTE: Never commit real API keys or sensitive credentials into source control.
# ==============================================================================

# Application Environment (development, testing, production)
PHOENIX_ENVIRONMENT=development

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PHOENIX_LOG_LEVEL=INFO

# Random Seed for Reproducibility
PHOENIX_RANDOM_SEED=42

# Execution & Network Timeouts
PHOENIX_REQUEST_TIMEOUT=60.0
PHOENIX_MAX_RETRIES=3

# Output Serialization Format (json, jsonl, csv)
PHOENIX_OUTPUT_FORMAT=json

# Custom Paths (Optional - defaults relative to project root)
# PHOENIX_DATASETS_DIR=datasets
# PHOENIX_RESULTS_DIR=results

# Model Provider Configurations (Phase 4 Multi-Model Benchmarking)
# PHOENIX-EVAL defaults to 'mock' provider and runs fully without any external API keys.
PHOENIX_DEFAULT_PROVIDER=mock
PHOENIX_DEFAULT_MODEL=mock-model-v1

# Real Provider API Keys & Base URLs (Leave blank or unset for mock experiments)
# Real provider runs require setting the relevant environment variable prior to execution.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_API_KEY=your-google-api-key-here
